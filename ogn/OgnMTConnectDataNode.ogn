{
    "MTConnectDataNode": {
        "version": 1,
        "description": "Outputs MTConnect data values for given dataItem IDs",
        "uiName": "MTConnect Data Node",
        "category": "MTConnect",
        "inputs": {
            "dataItemIds": {
                "type": "string[]",
                "description": "List of dataItem IDs to retrieve values for"
            }
        },
        "outputs": {
            "values": {
                "type": "float[]",
                "description": "Values corresponding to the dataItem IDs"
            },
            "timestamps": {
                "type": "string[]",
                "description": "Timestamps for the values"
            }
        }
    }
}