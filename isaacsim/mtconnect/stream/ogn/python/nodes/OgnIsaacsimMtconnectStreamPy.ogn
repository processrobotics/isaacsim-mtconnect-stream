{
    "IsaacsimMtconnectStreamPy": {
        "version": 1,
        "language": "python",
        "icon": "icons/icon.svg",
        "uiName": "MTConnect Stream Node",
        "description": [
            "MTConnect stream connector",
            "Connect MTConnect DataItems to prims/attributes/xforms/etc"
        ],
        "categoryDefinitions": "config/CategoryDefinition.json",
        "categories": ["extension:Category"],
        "inputs": {
            "execIn" : {
                "type" : "execution",
                "uiName": "Exec In",
                "description": "Triggering this causes the sensor pipeline to be generated"
            },
            "dataItemIds": {
                "type": "token[]",
                "uiName": "DataItem IDs",
                "description": "List of dataItem IDs to retrieve values for",
                "default": []
            }
        },
        "outputs": {
            "execOut": {
                "type" : "execution",
                "uiName": "Exec Out",
                "description": "Triggering this causes the sensor pipeline to be generated"
            },
            "timestamps": {
                "type": "token[]",
                "uiName": "Timestamps",
                "description": "Timestamps for the values"
            },
            "intValues": {
                "type": "int[]",
                "uiName": "int[]",
                "description": "Values as integers (0 if conversion fails)"
            },
            "doubleValues": {
                "type": "double[]",
                "uiName": "double[]",
                "description": "Values as doubles (0.0 if conversion fails)"
            },
            "stringValues": {
                "type": "token[]",
                "uiName": "string[]",
                "description": "Values as strings (empty string if no value)"
            }
        }
    }
}
